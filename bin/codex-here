#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=bin/_agent-here-common.sh
source "${SCRIPT_DIR}/_agent-here-common.sh"

agent_here_init codex "$@"

if [ "$AGENT_HERE_NEW_SESSION" -eq 0 ]; then
  codex_args=(resume --last --yolo --search)
else
  codex_args=(--yolo --search)
fi
codex_args+=("${AGENT_HERE_ARGS[@]}")

agent_here_run "${codex_args[@]}"
