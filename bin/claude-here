#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
# shellcheck source=bin/_agent-here-common.sh
source "${SCRIPT_DIR}/_agent-here-common.sh"

agent_here_init "$@"

claude_command=(claude --dangerously-skip-permissions --chrome)
if [ "${AGENT_HERE_NEW_SESSION}" -eq 0 ]; then
  claude_command+=(-c)
fi
claude_command+=("${AGENT_HERE_ARGS[@]}")

agent_here_run "${claude_command[@]}"
