#!/usr/bin/env bash
set -euo pipefail

# Docker Sandboxes pulls the template with its own runtime, not from the host
# Docker image store. This helper imports the GHCR image into the sbx template
# store explicitly, which is useful for pre-warming or offline reuse.
IMAGE="${AGENT_HERE_IMAGE:-ghcr.io/cainiaocome/ai-in-container:docker-sandbox}"
TMP="$(mktemp "${TMPDIR:-/tmp}/ai-in-container-template.XXXXXX")"
trap 'rm -f "$TMP"' EXIT

docker pull "$IMAGE"
docker image save "$IMAGE" -o "$TMP"
sbx template load "$TMP"
